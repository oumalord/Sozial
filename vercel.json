{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].ts": { "maxDuration": 30 },
    "api/cron/*.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/publish", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/evergreen", "schedule": "0 * * * *" }
  ]
}